# Neuronection Auth Kit — example environment (value-free).
#
# The kit reads configuration through AuthConfig.from_env("<PREFIX>") and
# KeyRing.from_env("<PREFIX>"); the prefix below is "APP" — replace it with
# your product's env prefix. Everything is optional except the key family
# in production (weak or missing keys refuse to boot there; dev/test fall
# back to per-process ephemeral keys).

# ─── Identity ────────────────────────────────────────────────────────────
# "server" (default) or "desktop" (mounts the Desktop Identity Mode exchange)
APP_IDENTITY_MODE=server

# ─── Key family (per-purpose; never derive one from another) ─────────────
# Generate each independently, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SESSION_KEY=
APP_REFRESH_KEY=
# Fernet at-rest key (secrets at rest — see docs/atrest.md):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_DATA_KEY=
# Prior at-rest keys (comma-separated, decryption-only) during rotation.
APP_DATA_KEY_PREVIOUS=

# ─── Tokens & lockout (defaults shown) ──────────────────────────────────
APP_AUTH_ACCESS_TTL_MINUTES=15
APP_AUTH_REFRESH_TTL_DAYS=14
APP_AUTH_REFRESH_ABSOLUTE_DAYS=30
APP_AUTH_LOCKOUT_THRESHOLD=5
APP_AUTH_LOCKOUT_MINUTES=15

# ─── Access & cookies ────────────────────────────────────────────────────
# Public self-registration (default true). Server products often disable it.
APP_REGISTRATION_ENABLED=true
# Set true when serving over TLS — enables the Secure cookie flag.
APP_COOKIE_SECURE=false
# Trusted reverse-proxy hops in front of the app (X-Forwarded-For).
# Miscounting lets clients spoof their IP past rate limits — set
# deliberately, 0 when there is no proxy.
APP_TRUSTED_PROXY_COUNT=0
